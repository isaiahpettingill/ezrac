// Motorola 6809 operand grammar. Brackets are indexed indirection and commas
// inside brackets stay part of one operand.
architecture_instruction = { SOI ~ architecture_ws ~ architecture_mnemonic ~ (architecture_ws1 ~ architecture_operands)? ~ architecture_ws ~ EOI }
architecture_mnemonic = { architecture_atom }
architecture_operands = { m6809_operand ~ (architecture_ws ~ architecture_comma ~ architecture_ws ~ m6809_operand)* }
m6809_operand = { m6809_element* }
m6809_element = _{ m6809_parenthesized | m6809_bracketed | architecture_double_quoted | architecture_single_quoted | architecture_operator | architecture_atom }
m6809_nested_element = _{ m6809_parenthesized | m6809_bracketed | architecture_double_quoted | architecture_single_quoted | architecture_comma | architecture_operator | architecture_atom }
m6809_parenthesized = { architecture_lparen ~ architecture_ws ~ m6809_nested_element ~ (architecture_ws ~ m6809_nested_element)* ~ architecture_ws ~ architecture_rparen }
m6809_bracketed = { architecture_lbracket ~ architecture_ws ~ m6809_nested_element ~ (architecture_ws ~ m6809_nested_element)* ~ architecture_ws ~ architecture_rbracket }
