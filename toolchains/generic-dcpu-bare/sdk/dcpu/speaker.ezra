// Community two-channel speaker constants and source wrappers.

pub const LEFT: u16 = 0
pub const RIGHT: u16 = 1

@inline pub fn set_left(frequency: u16) {
    asm volatile(in frequency: u16 as reg16, clobber memory) {
        "set a, 0"
        "set b, {frequency}"
        "hwi 5"
    }
}

@inline pub fn set_right(frequency: u16) {
    asm volatile(in frequency: u16 as reg16, clobber memory) {
        "set a, 1"
        "set b, {frequency}"
        "hwi 5"
    }
}
