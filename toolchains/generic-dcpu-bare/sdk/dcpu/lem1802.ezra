// LEM1802 display constants for the Standard Compatibility profile.

pub const SCREEN_MAP: u16 = 0x8000
pub const WIDTH: u16 = 32
pub const HEIGHT: u16 = 12
pub const WORDS: u16 = 384

pub const LEM_COMMAND_MAP_SCREEN: u16 = 0
pub const LEM_COMMAND_MAP_FONT: u16 = 1
pub const LEM_COMMAND_MAP_PALETTE: u16 = 2
pub const LEM_COMMAND_SET_BORDER: u16 = 3
pub const LEM_COMMAND_DUMP_FONT: u16 = 4
pub const LEM_COMMAND_DUMP_PALETTE: u16 = 5

pub const COLOR_BLACK: u16 = 0
pub const COLOR_WHITE: u16 = 15

// Text-cell fields: blink in bit 7, background in bits 4..7, foreground in
// bits 8..11, and the ASCII character in bits 0..6.
pub const BLINK: u16 = 0x0080
