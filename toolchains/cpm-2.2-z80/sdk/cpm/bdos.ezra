pub const SYSTEM_RESET: u8 = 0
pub const CONSOLE_INPUT: u8 = 1
pub const CONSOLE_OUTPUT: u8 = 2
pub const READER_INPUT: u8 = 3
pub const PUNCH_OUTPUT: u8 = 4
pub const LIST_OUTPUT: u8 = 5
pub const DIRECT_CONSOLE_IO: u8 = 6
pub const GET_IO_BYTE: u8 = 7
pub const SET_IO_BYTE: u8 = 8
pub const PRINT_STRING: u8 = 9
pub const READ_CONSOLE_BUFFER: u8 = 10
pub const GET_CONSOLE_STATUS: u8 = 11
pub const RETURN_VERSION_NUMBER: u8 = 12
pub const RESET_DISK_SYSTEM: u8 = 13
pub const SELECT_DISK: u8 = 14
pub const OPEN_FILE: u8 = 15
pub const CLOSE_FILE: u8 = 16
pub const SEARCH_FOR_FIRST: u8 = 17
pub const SEARCH_FOR_NEXT: u8 = 18
pub const DELETE_FILE: u8 = 19
pub const READ_SEQUENTIAL: u8 = 20
pub const WRITE_SEQUENTIAL: u8 = 21
pub const MAKE_FILE: u8 = 22
pub const RENAME_FILE: u8 = 23
pub const RETURN_LOGIN_VECTOR: u8 = 24
pub const RETURN_CURRENT_DISK: u8 = 25
pub const SET_DMA_ADDRESS: u8 = 26
pub const GET_ALLOCATION_VECTOR: u8 = 27
pub const WRITE_PROTECT_DISK: u8 = 28
pub const GET_READ_ONLY_VECTOR: u8 = 29
pub const SET_FILE_ATTRIBUTES: u8 = 30
pub const GET_DISK_PARAMETER_BLOCK: u8 = 31
pub const GET_SET_USER_CODE: u8 = 32
pub const READ_RANDOM: u8 = 33
pub const WRITE_RANDOM: u8 = 34
pub const COMPUTE_FILE_SIZE: u8 = 35
pub const SET_RANDOM_RECORD: u8 = 36
pub const RESET_DRIVE: u8 = 37
pub const ACCESS_DRIVE: u8 = 38
pub const FREE_DRIVE: u8 = 39
pub const WRITE_RANDOM_WITH_ZERO_FILL: u8 = 40

pub const BDOS_ENTRY: u16 = 0x0005
pub const DEFAULT_DMA_ADDRESS: u16 = 0x0080

// BDOS returns the raw A value. Keep it visible to callers: zero is success,
// FFh is the usual file/directory error, and record I/O uses operation-specific
// values such as EOF, disk full, and directory full.
pub const BDOS_RESULT_OK: u8 = 0
pub const BDOS_RESULT_EOF: u8 = 1
pub const BDOS_RESULT_DISK_FULL: u8 = 1
pub const BDOS_RESULT_DIRECTORY_FULL: u8 = 2
pub const BDOS_RESULT_ERROR: u8 = 0xFF
pub const BDOS_SEARCH_NO_MATCH: u8 = 0xFF

pub const OPEN_NOT_FOUND: u8 = 0xFF
pub const CLOSE_ERROR: u8 = 0xFF
pub const DELETE_NOT_FOUND: u8 = 0xFF
pub const CREATE_ERROR: u8 = 0xFF
pub const RENAME_ERROR: u8 = 0xFF
pub const READ_END_OF_FILE: u8 = 1
pub const READ_DISK_ERROR: u8 = 2
pub const WRITE_DISK_FULL: u8 = 1
pub const WRITE_DIRECTORY_FULL: u8 = 2
pub const RANDOM_READ_END_OF_FILE: u8 = 1
pub const RANDOM_READ_DISK_ERROR: u8 = 2
pub const RANDOM_WRITE_DISK_FULL: u8 = 1
pub const RANDOM_WRITE_DIRECTORY_FULL: u8 = 2

pub const BDOS_USER_DEFAULT: u8 = 0
pub const BDOS_USER_MAX: u8 = 15

pub fn is_success(result: u8) -> bool {
    return result == BDOS_RESULT_OK
}

pub fn is_error(result: u8) -> bool {
    return result == BDOS_RESULT_ERROR
}

pub fn search_found(result: u8) -> bool {
    return result != BDOS_SEARCH_NO_MATCH
}

pub fn read_record_complete(result: u8) -> bool {
    return result == BDOS_RESULT_OK
}

pub fn read_record_end(result: u8) -> bool {
    return result == READ_END_OF_FILE
}

pub fn read_record_failed(result: u8) -> bool {
    return result == READ_DISK_ERROR || result == BDOS_RESULT_ERROR
}

pub fn write_record_complete(result: u8) -> bool {
    return result == BDOS_RESULT_OK
}

pub fn write_record_disk_full(result: u8) -> bool {
    return result == WRITE_DISK_FULL
}

pub fn write_record_directory_full(result: u8) -> bool {
    return result == WRITE_DIRECTORY_FULL
}

pub fn random_read_end(result: u8) -> bool {
    return result == RANDOM_READ_END_OF_FILE
}

pub fn random_write_disk_full(result: u8) -> bool {
    return result == RANDOM_WRITE_DISK_FULL
}

pub fn random_write_directory_full(result: u8) -> bool {
    return result == RANDOM_WRITE_DIRECTORY_FULL
}

pub fn user_valid(code: u8) -> bool {
    return code <= BDOS_USER_MAX
}

pub fn call(function: u8) {
    asm volatile(in function: u8 as reg8, clobber af, clobber bc, clobber de, clobber hl, clobber flags, clobber memory) {
        "ld c, {function}"
        "call 0005h"
    }
}

pub fn call_e(function: u8, value: u8) {
    asm volatile(in function: u8 as mem, in value: u8 as mem, clobber af, clobber bc, clobber de, clobber hl, clobber flags, clobber memory) {
        "ld a, {function}"
        "ld c, a"
        "ld a, {value}"
        "ld e, a"
        "call 0005h"
    }
}

pub fn call_de(function: u8, value: u16) {
    asm volatile(in function: u8 as mem, in value: u16 as mem, clobber af, clobber bc, clobber de, clobber hl, clobber flags, clobber memory) {
        "ld a, {function}"
        "ld c, a"
        "ld de, {value}"
        "call 0005h"
    }
}

pub fn call_a(function: u8) -> u8 {
    let result: u8 = 0
    asm volatile(in function: u8 as reg8, out result: u8 as reg8, clobber af, clobber bc, clobber de, clobber hl, clobber flags, clobber memory) {
        "ld c, {function}"
        "call 0005h"
        "ld {result}, a"
    }
    return result
}

pub fn call_de_a(function: u8, value: u16) -> u8 {
    let result: u8 = 0
    asm volatile(in function: u8 as mem, in value: u16 as mem, out result: u8 as reg8, clobber af, clobber bc, clobber de, clobber hl, clobber flags, clobber memory) {
        "ld a, {function}"
        "ld c, a"
        "ld de, {value}"
        "call 0005h"
        "ld {result}, a"
    }
    return result
}

pub fn call_hl(function: u8) -> u16 {
    let result: u16 = 0
    asm volatile(in function: u8 as reg8, out result: u16 as reg16, clobber af, clobber bc, clobber de, clobber hl, clobber flags, clobber memory) {
        "ld c, {function}"
        "call 0005h"
        "ld {result}, hl"
    }
    return result
}

pub fn console_input() -> u8 {
    return call_a(CONSOLE_INPUT)
}

pub fn console_output(ch: u8) {
    call_e(CONSOLE_OUTPUT, ch)
}

pub fn reader_input() -> u8 {
    return call_a(READER_INPUT)
}

pub fn punch_output(ch: u8) {
    call_e(PUNCH_OUTPUT, ch)
}

pub fn list_output(ch: u8) {
    call_e(LIST_OUTPUT, ch)
}

pub fn direct_console_io(value: u8) -> u8 {
    return call_de_a(DIRECT_CONSOLE_IO, cast<u16>(value))
}

pub fn get_io_byte() -> u8 {
    return call_a(GET_IO_BYTE)
}

pub fn set_io_byte(value: u8) {
    call_e(SET_IO_BYTE, value)
}

pub fn print_string(address: u16) {
    call_de(PRINT_STRING, address)
}

pub fn read_console_buffer(address: u16) {
    call_de(READ_CONSOLE_BUFFER, address)
}

pub fn read_console_buffer_at(buffer: ptr<u8>) {
    read_console_buffer(cast<u16>(buffer))
}

pub fn console_status() -> u8 {
    return call_a(GET_CONSOLE_STATUS)
}

pub fn version() -> u16 {
    return call_hl(RETURN_VERSION_NUMBER)
}

pub fn reset_disk_system() {
    call(RESET_DISK_SYSTEM)
}

pub fn select_disk(drive: u8) {
    call_e(SELECT_DISK, drive)
}

pub fn open_file(fcb: u16) -> u8 {
    return call_de_a(OPEN_FILE, fcb)
}

pub fn open_file_at(fcb: ptr<u8>) -> u8 {
    return open_file(cast<u16>(fcb))
}

pub fn close_file(fcb: u16) -> u8 {
    return call_de_a(CLOSE_FILE, fcb)
}

pub fn close_file_at(fcb: ptr<u8>) -> u8 {
    return close_file(cast<u16>(fcb))
}

pub fn search_for_first(fcb: u16) -> u8 {
    return call_de_a(SEARCH_FOR_FIRST, fcb)
}

pub fn search_for_next() -> u8 {
    return call_a(SEARCH_FOR_NEXT)
}

pub fn delete_file(fcb: u16) -> u8 {
    return call_de_a(DELETE_FILE, fcb)
}

pub fn read_sequential(fcb: u16) -> u8 {
    return call_de_a(READ_SEQUENTIAL, fcb)
}

pub fn read_sequential_at(fcb: ptr<u8>) -> u8 {
    return read_sequential(cast<u16>(fcb))
}

pub fn write_sequential(fcb: u16) -> u8 {
    return call_de_a(WRITE_SEQUENTIAL, fcb)
}

pub fn make_file(fcb: u16) -> u8 {
    return call_de_a(MAKE_FILE, fcb)
}

pub fn rename_file(fcb: u16) -> u8 {
    return call_de_a(RENAME_FILE, fcb)
}

pub fn login_vector() -> u16 {
    return call_hl(RETURN_LOGIN_VECTOR)
}

pub fn current_disk() -> u8 {
    return call_a(RETURN_CURRENT_DISK)
}

pub fn set_dma_address(address: u16) {
    call_de(SET_DMA_ADDRESS, address)
}

pub fn allocation_vector() -> u16 {
    return call_hl(GET_ALLOCATION_VECTOR)
}

pub fn write_protect_disk() {
    call(WRITE_PROTECT_DISK)
}

pub fn read_only_vector() -> u16 {
    return call_hl(GET_READ_ONLY_VECTOR)
}

pub fn set_file_attributes(fcb: u16) -> u8 {
    return call_de_a(SET_FILE_ATTRIBUTES, fcb)
}

pub fn disk_parameter_block() -> u16 {
    return call_hl(GET_DISK_PARAMETER_BLOCK)
}

pub fn get_user_code() -> u8 {
    return call_de_a(GET_SET_USER_CODE, 0x00FF)
}

pub fn set_user_code(code: u8) {
    call_e(GET_SET_USER_CODE, code)
}

pub fn read_random(fcb: u16) -> u8 {
    return call_de_a(READ_RANDOM, fcb)
}

pub fn write_random(fcb: u16) -> u8 {
    return call_de_a(WRITE_RANDOM, fcb)
}

pub fn compute_file_size(fcb: u16) -> u8 {
    return call_de_a(COMPUTE_FILE_SIZE, fcb)
}

pub fn compute_file_size_at(fcb: ptr<u8>) -> u8 {
    return compute_file_size(cast<u16>(fcb))
}

pub fn populate_random_record(fcb: u16) {
    call_de(SET_RANDOM_RECORD, fcb)
}

pub fn populate_random_record_at(fcb: ptr<u8>) {
    populate_random_record(cast<u16>(fcb))
}

pub fn reset_drive(mask: u16) -> u8 {
    return call_de_a(RESET_DRIVE, mask)
}

pub fn access_drive(mask: u16) {
    call_de(ACCESS_DRIVE, mask)
}

pub fn free_drive(mask: u16) {
    call_de(FREE_DRIVE, mask)
}

pub fn write_random_with_zero_fill(fcb: u16) -> u8 {
    return call_de_a(WRITE_RANDOM_WITH_ZERO_FILL, fcb)
}

pub fn system_reset() {
    call(SYSTEM_RESET)
}

pub fn get_console_status() -> u8 {
    return console_status()
}

pub fn return_version_number() -> u16 {
    return version()
}

pub fn return_login_vector() -> u16 {
    return login_vector()
}

pub fn return_current_disk() -> u8 {
    return current_disk()
}

pub fn set_dma(address: u16) {
    set_dma_address(address)
}

pub fn get_allocation_vector() -> u16 {
    return allocation_vector()
}

pub fn get_read_only_vector() -> u16 {
    return read_only_vector()
}

pub fn get_set_user_code(value: u8) -> u8 {
    return call_de_a(GET_SET_USER_CODE, cast<u16>(value))
}

// User areas are global BDOS state, not an FCB byte. Keep these helpers next to
// the BDOS function 32 wrapper so an FCB cannot accidentally claim ownership.
pub fn user_code() -> u8 {
    return get_user_code()
}

pub fn set_user(code: u8) {
    if user_valid(code) {
        set_user_code(code)
    }
}

pub fn get_user() -> u8 {
    return get_user_code()
}

// Pointer forms keep callers from hand-casting the common FCB address.
pub fn delete_file_at(fcb: ptr<u8>) -> u8 {
    return delete_file(cast<u16>(fcb))
}

pub fn search_for_first_at(fcb: ptr<u8>) -> u8 {
    return search_for_first(cast<u16>(fcb))
}

pub fn write_sequential_at(fcb: ptr<u8>) -> u8 {
    return write_sequential(cast<u16>(fcb))
}

pub fn make_file_at(fcb: ptr<u8>) -> u8 {
    return make_file(cast<u16>(fcb))
}

pub fn rename_file_at(fcb: ptr<u8>) -> u8 {
    return rename_file(cast<u16>(fcb))
}

pub fn set_file_attributes_at(fcb: ptr<u8>) -> u8 {
    return set_file_attributes(cast<u16>(fcb))
}

pub fn read_random_at(fcb: ptr<u8>) -> u8 {
    return read_random(cast<u16>(fcb))
}

pub fn write_random_at(fcb: ptr<u8>) -> u8 {
    return write_random(cast<u16>(fcb))
}

pub fn write_random_with_zero_fill_at(fcb: ptr<u8>) -> u8 {
    return write_random_with_zero_fill(cast<u16>(fcb))
}

// Names that describe the CP/M record model directly. Every operation returns
// the raw BDOS A value except apply_record_position, which updates the FCB.
pub fn open(fcb: u16) -> u8 {
    return open_file(fcb)
}

pub fn open_at(fcb: ptr<u8>) -> u8 {
    return open_file_at(fcb)
}

pub fn close(fcb: u16) -> u8 {
    return close_file(fcb)
}

pub fn close_at(fcb: ptr<u8>) -> u8 {
    return close_file_at(fcb)
}

pub fn create(fcb: u16) -> u8 {
    return make_file(fcb)
}

pub fn create_at(fcb: ptr<u8>) -> u8 {
    return make_file_at(fcb)
}

pub fn delete(fcb: u16) -> u8 {
    return delete_file(fcb)
}

pub fn delete_at(fcb: ptr<u8>) -> u8 {
    return delete_file_at(fcb)
}

pub fn rename(fcb: u16) -> u8 {
    return rename_file(fcb)
}

pub fn rename_at(fcb: ptr<u8>) -> u8 {
    return rename_file_at(fcb)
}

pub fn read_record(fcb: u16) -> u8 {
    return read_sequential(fcb)
}

pub fn read_record_at(fcb: ptr<u8>) -> u8 {
    return read_sequential_at(fcb)
}

pub fn write_record(fcb: u16) -> u8 {
    return write_sequential(fcb)
}

pub fn write_record_at(fcb: ptr<u8>) -> u8 {
    return write_sequential_at(fcb)
}

pub fn read_random_record(fcb: u16) -> u8 {
    return read_random(fcb)
}

pub fn read_random_record_at(fcb: ptr<u8>) -> u8 {
    return read_random_at(fcb)
}

pub fn write_random_record(fcb: u16) -> u8 {
    return write_random(fcb)
}

pub fn write_random_record_at(fcb: ptr<u8>) -> u8 {
    return write_random_at(fcb)
}

pub fn apply_record_position(fcb: u16) {
    populate_random_record(fcb)
}

pub fn apply_record_position_at(fcb: ptr<u8>) {
    populate_random_record_at(fcb)
}

pub fn compute_size(fcb: u16) -> u8 {
    return compute_file_size(fcb)
}

pub fn compute_size_at(fcb: ptr<u8>) -> u8 {
    return compute_file_size_at(fcb)
}

