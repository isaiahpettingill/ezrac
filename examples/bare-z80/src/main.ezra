volatile mmio WORD: ptr<u8> = 0xF000
port S : u8 = 0x12
port P : u8 = 0x13
port I : u8 = 0x14
port M : u8 = 0x15

fn main() {
    let i: ptr<u8> = WORD
    let count_letter_s: u8 = 0
    let count_letter_p: u8 = 0
    let count_letter_i: u8 = 0
    let count_letter_m: u8 = 0
    loop {
        let letter: u8 = *i
        if letter == 'S' {
            count_letter_s += 1;
        } else if letter == 'P' {
            count_letter_p += 1;
        } else if letter == 'I' {
            count_letter_i += 1;
        } else if letter == 'M' {
            count_letter_m += 1;
        } else if letter == '$' {
            break;
        }
        i = i+1;
    }
}
