import dos.console

// 15 input bytes, DOS's two buffer-control bytes, and one '$' terminator.
global name_buffer: [u8; 18] = [15]

global player_race: u8 = 0
const RACE_HUMAN: u8 = 1
const RACE_DWARF: u8 = 2
const RACE_ELF: u8 = 3

global START_TEXT: ptr<u8> = "Welcome, weary traveler. What is your name? $"
global HELLO: ptr<u8> = "Hello, $"
global CHOOSE_RACE: ptr<u8> = "What is your race? "
global RACE_OPTIONS: ptr<u8> = "(1) HUMAN (2) DWARF (3) ELF$"

fn race_string(index: u8) -> ptr<u8> {
    if index == 1 {
        return "Human$"
    }
    if index == 2 {
        return "Dwarf$"
    }
    if index == 3 {
        return "Elf$"
    }
    return "NA$"
}

fn char_to_int(ch: u8) -> u8 {
    if ch == '1' {
        return 1
    }
    if ch == '2' {
        return 2
    }
    if ch == '3' {
        return 3
    }
    return 0
}

fn prompt_race(){
    console.print_dollar(CHOOSE_RACE)
    console.newline()
    console.print_dollar(RACE_OPTIONS)
}

fn get_option(prompt: ptr<fn()>, option: ptr<u8>) {
    let choice: u8 = 0
    while choice == 0 {
        prompt()
        let input: u8 = console.read_char()
        console.newline()
        choice = char_to_int(input)
    }
    *option = choice
}

@inline fn get_name(){
    console.print_dollar(START_TEXT)
    console.read_buffered(&name_buffer[0])
    console.newline()
    console.print_dollar(HELLO)
    console.print_buffered_dollar(&name_buffer[0])
    console.newline()
}

fn setup_sequence() {
    get_name()
    get_option(&prompt_race, &player_race)
    console.print_dollar("Ah, a $")
    console.print_dollar(race_string(player_race))
    console.print_dollar("! Very interesting...$")
    console.newline()
}

fn prompt_level_one(){
    console.print_dollar("What do you do?$")
    console.newline()
    console.print_dollar("(1) Go up and talk to the troll$")
    console.newline()
    console.print_dollar("(2) Attack the troll$")
    console.newline()
    console.print_dollar("(3) Try to go around the ravine$")
    console.newline()
}

fn prompt_level_two(){
    console.print_dollar("How do you answer the riddle?$")
    console.newline()
    console.print_dollar("(1) Your mom (2) Stacy (3) Candace$")
}

fn level_two() {
    console.print_dollar("The troll twiddles his thumbs...$")
    console.newline()
    console.print_dollar("'Who does Jeremy Johnson date in Phineas and Ferb?'$")
    let choice: u8 = 0
    get_option(&prompt_level_two, &choice)

    if choice == 1 {
        console.print_dollar("The troll gets wrecked and crashes out. You pass the bridge$")
    }
    if choice == 2 {
        console.print_dollar("WRONG! Troll throws you off bridge$")
        return
    }
    if choice == 3 {
        console.print_dollar("That is correct. Troll lets you cross.$")
    }
}

fn level_one() {
    let choice: u8 = 0

    get_option(&prompt_level_one, &choice)
    if choice == 1 {
        console.print_dollar("The troll eyes you suspiciously and speaks in a raspy voice.")
        console.newline()
        console.print_dollar("'You may cross, but you must answer my riddle.'$")
        level_two()
        return
    }
    if choice == 2 {
        console.print_dollar("The troll kills you$")
        console.newline()
        return
    }
    if choice == 3 {
        console.print_dollar("You wander for hours and eventually return to the bridge$")
    }
    level_one()
}

fn main() {
    setup_sequence()
    console.print_dollar("You come to a ravine with a rickety bridge. A grupmy old troll guards the path.$")
    level_one()
}
