volatile mmio output: ptr<u16> = 0x0100

// The embeds will remain in the binary, but their contents will not be used at runtime.
// Embeds are included in the binary as-is, and their contents are not modified by the compiler.
embed matrix_a : [u16; 9] = [1, 2, 3, 4, 3, 0, 0, 2, 4]
embed matrix_b : [u16; 9] = [7, 0, 3, 2, 2, 0, 1, 3, 9]


fn matmul3x3(a: ptr<u8>, b: ptr<u8>, result_matrix: ptr<u8>) {
    *(result_matrix + 0) = a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
    *(result_matrix + 1) = a[3] * b[0] + a[4] * b[1] + a[5] * b[2]
    *(result_matrix + 2) = a[6] * b[0] + a[7] * b[1] + a[8] * b[2]
    *(result_matrix + 3) = a[0] * b[3] + a[1] * b[4] + a[2] * b[5]
    *(result_matrix + 4) = a[3] * b[3] + a[4] * b[4] + a[5] * b[5]
    *(result_matrix + 5) = a[6] * b[3] + a[7] * b[4] + a[8] * b[5]
    *(result_matrix + 6) = a[0] * b[6] + a[1] * b[7] + a[2] * b[8]
    *(result_matrix + 7) = a[3] * b[6] + a[4] * b[7] + a[5] * b[8]
    *(result_matrix + 8) = a[6] * b[6] + a[7] * b[7] + a[8] * b[8]
}

fn main() {
    matmul3x3(&matrix_a, &matrix_b, output)
}
