volatile mmio INPUT: ptr<u16> = 0xF200
volatile mmio OUTPUT: ptr<u16> = 0xF202

// Recursive Euclid function
fn euclid(a: i32, b: i32) -> i32 {
    if b == 0 {
        // return a
        return a
    }
    // calculate a % b
    let c: i32 = a % b
    // recurse on the modulus
    return euclid(b, c)
}

fn main() {
    // set output
    OUTPUT = euclid(*INPUT, *(INPUT + 1))
}
