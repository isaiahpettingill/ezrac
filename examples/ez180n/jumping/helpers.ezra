import ezra.int

global lives_string: [u8; 9] = ['L', 'i', 'v', 'e', 's', ':', ' ', '2', '0']

const CHAR_ZERO : u8 = 48

@inline pub fn get_lives_string() -> ptr<u8> {
    return cast<ptr<u8>>(&lives_string)
}

pub fn set_lives_string(lives: u8) {
    let the_lives: u8 = lives
    if lives > 99 {
        the_lives = 99
    }
    let high_byte: u8, low_byte: u8 = int.divmod(lives, 10)
    lives_string[7] = high_byte + CHAR_ZERO
    lives_string[8] = low_byte + CHAR_ZERO
}

pub fn write_line(x: u8, y: u8, text: ptr<u8>){
    let cursor: ptr<u8> = text
    let x1 : u8 = x
    while *cursor != '\0' {
        let char: u8 = *cursor
        console.put_char(x1, y, char)
        cursor += 1
        x1 += 1
    }
}

@cfg(pointer_width(24))
pub fn get_char(x: u8, y: u8) -> u8 {
    let offset: u24 = cast<u24>(y) * cast<u24>(WIDTH) + cast<u24>(x)
    let cell: ptr<u8> = FRAMEBUFFER + offset
    return *cell
}

@cfg(pointer_width(16))
pub fn get_char(x: u8, y: u8) -> u8 {
    let offset: u16 = cast<u16>(y) * cast<u16>(WIDTH) + cast<u16>(x)
    let cell: ptr<u8> = FRAMEBUFFER + offset
    return *cell
}
