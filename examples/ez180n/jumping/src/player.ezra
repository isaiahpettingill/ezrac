import ez180n.console
import helpers

const FLOOR_Y: u8 = console.HEIGHT - 1
const STARTING_Y: u8 = 30
const STARTING_X: u8 = 10

global PLAYER_X: u8 = STARTING_X
global OLD_PLAYER_X: u8 = STARTING_X
global PLAYER_Y: u8 = STARTING_Y
global OLD_PLAYER_Y: u8 = FLOOR_Y
global PLAYER_VY: u8 = 0
global PLAYER_LIVES: u8 = 20
global DID_JUMP: bool = false

@inline pub fn get_player_pos() -> u8,u8 {
    return PLAYER_X, PLAYER_Y
}

@inline pub fn get_lives() -> u8 {
    return PLAYER_LIVES
}

pub fn deal_damage(damage: u8) {
    if damage < PLAYER_LIVES {
        PLAYER_LIVES -= damage
    }
    else {
        PLAYER_LIVES = 0
        die()
    }
}

@inline fn die() {
    asm { "nop" }    
}

fn set_player_x(x: u8){
    OLD_PLAYER_X = PLAYER_X
    PLAYER_X = x
}

fn inc_player_x(dx: u8){
    set_player_x(PLAYER_X + dx)
}

fn dec_player_x(dx: u8){
    set_player_x(PLAYER_X - dx)
}

fn set_player_y(y: u8){
    OLD_PLAYER_Y = PLAYER_Y
    PLAYER_Y = y
}

fn dec_player_y(dy: u8){
    set_player_y(PLAYER_Y - dy)
}

fn clamp_player_position(){
    if PLAYER_X >= console.WIDTH {
        set_player_x(console.WIDTH - 1)
    }
    else if PLAYER_X <= 0 {
        set_player_x(0)
    }

    if PLAYER_Y >= console.HEIGHT {
        set_player_y(console.HEIGHT - 1)
    }

    else if PLAYER_Y <= 0 {
        set_player_y(0)
    }
}

fn do_player_controls(){
    if console.button_down(0, console.BUTTON_RIGHT) {
        inc_player_x(1)
    }
    if console.button_down(0, console.BUTTON_LEFT) {
        dec_player_x(1)
    }
    if console.button_down(0, console.BUTTON_A) && !DID_JUMP {
        PLAYER_VY = 2
        DID_JUMP=true
    }
}

fn gravity(){
    
    if PLAYER_VY != 0  {
        dec_player_y(PLAYER_VY)
        PLAYER_VY -= 1
        return
    }
    
    let char: u8 = helpers.get_char(PLAYER_X, PLAYER_Y + 1)

    if char != console.CHAR_SPACE {
        DID_JUMP=false
        return
    }

    if PLAYER_Y < FLOOR_Y {
        set_player_y(PLAYER_Y + 1)
    }
    else {
        set_player_y(FLOOR_Y)
        DID_JUMP=false
    }
}


pub fn draw() {
    console.put_char(PLAYER_X, PLAYER_Y, '@')
}

pub fn update() {
    do_player_controls()
    gravity()
    clamp_player_position()
}
