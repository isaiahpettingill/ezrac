import ez180n.console
import helpers
import player

// LEVEL
// ==================================================

fn draw_level_1(){
    helpers.write_line(0, console.HEIGHT - 3, "=====================")
}


// HUD
// ==================================================

global HUD_STATE: u8 = 0

fn draw_hud() {
    if HUD_STATE == 0 {
        helpers.write_line(1, 1, "DPAD to move, A to jump")
    }
    if HUD_STATE == 1 {
        helpers.write_line(1, 1, "Level 1")
    }
}

// MAIN
// ==================================================

fn main() {
    loop {
        player.update()
        console.fill(console.CHAR_SPACE)
        player.draw()
        draw_level_1()
        draw_hud()
        console.present()
        console.wait_tick()
    }
}
