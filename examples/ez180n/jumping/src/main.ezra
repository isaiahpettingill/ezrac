import ez180n.console
import helpers
import player
import hud
import level

// MAIN
// ==================================================

fn main() {
    loop {
        player.update()

        level.interact_level()

        console.fill(console.CHAR_SPACE)
        player.draw()
        level.draw_level()
        hud.draw_hud()

        console.present()
        console.wait_tick()
    }
}
