import ez180n.console
import helpers
import player
import hud
// LEVEL
// ==================================================

fn interact_level_1(){
    
}

fn draw_level_1(){
    helpers.write_line(0, console.HEIGHT - 3, "=====================")
}


// MAIN
// ==================================================

fn main() {
    loop {
        player.update()
        console.fill(console.CHAR_SPACE)
        player.draw()
        draw_level_1()
        hud.draw_hud()
        console.present()
        console.wait_tick()
    }
}
