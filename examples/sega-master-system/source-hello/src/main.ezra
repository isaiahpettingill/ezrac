import sms.input
import sms.palette
import sms.system
import sms.video

fn main() {
    video.init_mode4()
    palette.set_background(0, palette.BLUE)
    video.enable_display()

    loop {
        system.halt_until_frame()

        if (input.read_player1() & input.BUTTON_1) != 0 {
            palette.set_background(0, palette.RED)
        } else {
            palette.set_background(0, palette.BLUE)
        }
    }
}
