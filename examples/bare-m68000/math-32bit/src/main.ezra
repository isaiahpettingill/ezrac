volatile mmio INPUT1 : ptr<i32> = 0x000090
volatile mmio INPUT2 : ptr<i32> = 0x0000A0
volatile mmio OUTPUT1 : ptr<i32> = 0x0000B0
volatile mmio OUTPUT2 : ptr<i32> = 0x0000C0

// Clamp n between min and max
fn clamp(n: i32, min: i32, max: i32) -> i32 {
    if n < min { return min }
    if n > max { return max }
    return n
}

// Calculate the greatest common divisor of two integers using the Euclidean algorithm.
fn euclid(a: i32, b: i32) -> i32 {
    if b == 0 { return a }
    return euclid(b, a % b)
}

fn main() {
    // set output 1 to the gcd and output 2 to the clamped gcd
    *OUTPUT1 = euclid(*INPUT1, *INPUT2)
    // Set output 2 to the clamped gcd
    *OUTPUT2 = clamp(*OUTPUT1, 0, 6502)
}
